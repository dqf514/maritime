# MariOS 部署配置模板（compose + 应用共用）
#
# 用法：
#   cp .env.example .env
#   然后把下面所有 [必填] 项填上 —— compose 缺值会**直接报错退出**，
#   不会静默用弱口令或随机密钥启动。
#
# 标注约定：
#   [compose]  只有 docker compose 用得到，应用不读
#   [app]      应用配置（对应 app/config.py 的 Settings 字段）
#   [必填]     生产必须显式设置；留空 = compose 报错
#
# 生成密钥：
#   openssl rand -hex 32          # 用于 JWT_SECRET / OPS_DATA_KEY
#   openssl rand -base64 24       # 用于数据库口令 / MinIO 口令
#
# 注意：注释单独成行（不要跟在赋值后面），避免两套 dotenv 解析器行为不一致。

# ────────────────────────── compose-only ──────────────────────────
# [compose] 数据库名 / 账号。库名与本文档其余部分保持一致（voyageos）。
POSTGRES_USER=voyageos
POSTGRES_DB=voyageos
# [compose][必填] 数据库口令
POSTGRES_PASSWORD=

# [compose] 备份保留天数 / 备份间隔（秒）
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# [compose] 受信代理 IP 段（传给 uvicorn --forwarded-allow-ips）。
# 反向代理后必须设置，否则全站共用一个限流桶（登录 5 次/分钟全局）。
# "*" = 信任全部（仅适合受控内网）；生产建议写成反代网段，如 172.16.0.0/12。
TRUSTED_PROXY_IPS=*

# [compose][必填] 前端访问 API 的地址。
# 注意：这个值在 **构建期** 内联进浏览器 bundle —— 改完必须重建 web 镜像
# （docker compose build web && docker compose up -d web）。
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ────────────────────────── 应用配置 ──────────────────────────
# [app][必填] JWT 签名密钥。留空时应用会生成**进程级随机**密钥：
# 重启后所有登录令牌失效；若 OPS_DATA_KEY 也没配，Fernet 加密数据将永久不可解。
JWT_SECRET=

# [app][必填] 平台侧数据加密密钥（租户数据源连接串 / AI key / M365 token 等）。
# 不要复用 JWT_SECRET —— 轮换 JWT 会连带毁掉已加密的数据。
OPS_DATA_KEY=

# [app] 令牌有效期（分钟）
JWT_EXPIRE_MINUTES=720

# [app] 模块许可证门禁。生产必须 none。
#   none = 正常按租户许可证放行（生产）
#   all  = 绕过全部模块许可证（**仅本地开发**，等于没有门禁）
LICENSE_DEV_UNLOCK=none

# [app] 运行环境。production 会关闭 /docs 与 /openapi.json。
ENV=production

# [app] HTTPS 部署时置 true（会话 cookie 加 Secure）
COOKIE_SECURE=false

# [app] 允许「任意邮箱免密登录」的桩后门。生产必须 false。
OAUTH_ALLOW_STUB=false

# [app] 启动时播种演示租户/账号。生产必须 false。
SEED_DEMO=false

# [app] 启动时播种目录/参考数据（模块目录、i18n、操作目录等）。只读副本可关。
STARTUP_SEED=true

# [app] 后台任务 worker（webhook 投递、定时报表、备份调度等）
JOB_WORKER_ENABLED=true
JOB_WORKER_INTERVAL=2.0

# [app] 进程内滑动窗口限流（登录等敏感端点）
RATE_LIMIT_ENABLED=true

# [app] 慢查询告警阈值（毫秒）；0 关闭
SLOW_QUERY_MS=200

# [app] 跨域来源（逗号分隔）—— 改成前端真实域名
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# [app] 公开地址（OAuth 回调 / 邮件里的链接）
API_PUBLIC_BASE=http://localhost:8000
WEB_PUBLIC_BASE=http://localhost:3000

# [app] 数据库连接串（compose 会用上面的账号口令覆盖）
DATABASE_URL=postgresql+psycopg://voyageos:voyageos@postgres:5432/voyageos

# [app] Postgres 连接池（SQLite 忽略）。显式化是为了让部署方一眼看到能调，
# 而不是吃 SQLAlchemy 的隐式默认（pool_size=5 / max_overflow=10，长连接不
# recycle → 云防火墙静默掐断，表现为"跑一夜后突然全 500"）。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# [app] 日志格式：json（默认，日志平台可直接解析）/ kv（人读 key=value）
LOG_FORMAT=json

# [app] /metrics 的抓取令牌。留空 = 生产环境该端点直接 404（不裸奔）。
METRICS_TOKEN=

# [app] 自定义 SQL 报表。默认关闭 —— raw SQL 能绕开声明式构造器的租户过滤。
# 开启后仍强制租户 WHERE 过滤。
ALLOW_CUSTOM_SQL_REPORTS=false

# [app] 出网白名单（逗号分隔的 host）。出网请求（webhook / 连接器测试 / LLM
# provider）只允许落到这些 host 或公网地址；内网/环回/元数据地址一律拒绝。
# 留空 = 只允许公网。
OUTBOUND_ALLOWED_HOSTS=

# [app] Microsoft 365 / Entra ID（留空则不可用；配合 OAUTH_ALLOW_STUB=false 时
#      平台没有可用登录方式 —— 首次部署请先配好 IdP 或临时用 API 密钥）
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# [app] Google OAuth（可选）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [app] 邮件通道：console | smtp | sendgrid | graph
EMAIL_CHANNEL=console
EMAIL_FROM=noreply@marios.local

# [app] AI / LLM 平台默认值（租户级 AiProvider 行会覆盖）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
# [app] 按量付费开关：True 时真实 AI 调用按 tokens 扣租户余额；默认关闭。
AI_METERING_ENABLED=false

# [app] AIS 外部数据源（留空则用内置估算）
AIS_BASE_URL=
AIS_API_KEY=

# [app] 应用名 / 版本（出现在 /healthz 里）
APP_NAME=MariOS API
APP_VERSION=0.1.0-wave0
