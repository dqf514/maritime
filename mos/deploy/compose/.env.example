# VoyageOS local / Stage A
POSTGRES_USER=voyageos
POSTGRES_PASSWORD=voyageos
POSTGRES_DB=voyageos
DATABASE_URL=postgresql+psycopg://voyageos:voyageos@postgres:5432/voyageos

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=voyageos
MINIO_ROOT_PASSWORD=voyageossecret
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=voyageos
S3_SECRET_KEY=voyageossecret
S3_BUCKET=voyageos
S3_REGION=us-east-1

JWT_SECRET=change-me-in-production-use-long-random
JWT_EXPIRE_MINUTES=720
LICENSE_DEV_UNLOCK=all

API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Public bases (OAuth redirects & email links)
API_PUBLIC_BASE=http://localhost:8000
WEB_PUBLIC_BASE=http://localhost:3000

# Microsoft 365 / Entra ID (leave empty + OAUTH_ALLOW_STUB=true for demo)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
OAUTH_ALLOW_STUB=true

# Email channel: console | smtp | sendgrid | graph
EMAIL_CHANNEL=console
EMAIL_FROM=noreply@voyageos.local
