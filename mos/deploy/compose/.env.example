# MariOS local / Stage A
# ⚠️ 本文件是【本地开发】默认值。生产部署前必须修改下列带 [PROD] 标记的行。
POSTGRES_USER=voyageos
POSTGRES_PASSWORD=voyageos          # [PROD] 改强密码
POSTGRES_DB=voyageos
DATABASE_URL=postgresql+psycopg://voyageos:voyageos@postgres:5432/voyageos  # [PROD] 与上面密码同步

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=voyageos
MINIO_ROOT_PASSWORD=voyageossecret  # [PROD] 改强密码
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=voyageos              # [PROD] 改
S3_SECRET_KEY=voyageossecret        # [PROD] 改
S3_BUCKET=voyageos
S3_REGION=us-east-1

JWT_SECRET=change-me-in-production-use-long-random  # [PROD] 必须改：openssl rand -hex 32
JWT_EXPIRE_MINUTES=720
# [PROD] 删除下一行！=all 会绕过全部模块许可证门禁（仅本地开发用）
LICENSE_DEV_UNLOCK=all
# [PROD] 建议开启：ENV=production（关闭 /docs 与 /openapi.json）
# ENV=production
# [PROD] HTTPS 部署时开启（cookie 加 Secure）
# COOKIE_SECURE=true

API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # [PROD] 改成你的前端域名
NEXT_PUBLIC_API_BASE=http://localhost:8000                    # [PROD] 改成 API 公网地址（构建期内联，改后需重建 web 镜像）

# Public bases (OAuth redirects & email links)
API_PUBLIC_BASE=http://localhost:8000   # [PROD] 改公网地址
WEB_PUBLIC_BASE=http://localhost:3000   # [PROD] 改公网地址

# Microsoft 365 / Entra ID (leave empty + OAUTH_ALLOW_STUB=true for demo)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# [PROD] 必须 false/删除！true = 任意邮箱免密登录后门（仅本地演示用）
OAUTH_ALLOW_STUB=true

# Email channel: console | smtp | sendgrid | graph
EMAIL_CHANNEL=console
EMAIL_FROM=noreply@marios.local
