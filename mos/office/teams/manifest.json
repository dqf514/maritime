{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "packageName": "com.voyageos.teams",
  "developer": {
    "name": "VoyageOS",
    "websiteUrl": "https://voyageos.local",
    "privacyUrl": "https://voyageos.local/privacy",
    "termsOfUseUrl": "https://voyageos.local/terms"
  },
  "name": {
    "short": "VoyageOS",
    "full": "VoyageOS Maritime Operating System"
  },
  "description": {
    "short": "Voyage alerts, approvals & deep links",
    "full": "Bring VoyageOS voyage alerts, charter approvals, and OmniSearch-style deep links into Microsoft Teams channels."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0B1F2A",
  "staticTabs": [
    {
      "entityId": "voyageos.home",
      "name": "Workbench",
      "contentUrl": "https://localhost:3000/home?embed=teams",
      "websiteUrl": "https://localhost:3000/home",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://localhost:3000/settings/office?embed=teams-config",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"]
    }
  ],
  "bots": [],
  "composeExtensions": [],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["localhost", "voyageos.local"],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000000",
    "resource": "api://localhost/voyageos"
  }
}
